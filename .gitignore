# Public datasets are downloaded, not redistributed - see scripts/Get-Dataset.ps1
data/raw/*.csv
data/external/*.csv
data/external/*.json

# Smoke-test output. Real stability runs SHOULD be committed - they are the contribution.
data/stability-runs/*smoketest*

# Same rule for frequency sweeps: real sweeps are the contribution and belong in the repo.
# Smoke tests do not. Anything else kept here needs an entry in the directory README saying
# whether it is dataset-grade - see the verify-3pt run for why that matters.
data/frequency-sweeps/*smoketest*

# Python
__pycache__/
*.py[cod]
.venv/
venv/
# Isolated env for the CuPy-based bandwidth kernel probes. Created with
# --system-site-packages so it reuses the main torch install rather than duplicating it.
.venv-cupy/
.ipynb_checkpoints/

# Editors / OS
.vscode/
.idea/
Thumbs.db
desktop.ini

# Probe telemetry written to the working directory when --telemetry is left at its default.
# The kept results live in data/probes/ as JSON; the raw 100 ms sample stream is scratch.
probe_telemetry.csv

# Raw HWiNFO sensor dumps. 300+ columns covering every CPU, motherboard, drive and fan sensor
# on the logging machine - almost all of it irrelevant here, and more host detail than belongs
# in a public repo. Distilled per-run extracts (timestamp, GPU core voltage, clock, power) are
# committed instead, beside the sweep they belong to.
data/HWiNFO-Data/
